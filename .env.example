# ── DEPLOYMENT MODE ────────────────────────────────────────────────────────────
# "cloud" for hosted Vercel deployment (https://clipper.vichith.in)
# "local" for zero-key local self-hosted docker / local python
CLIPPER_MODE=cloud

# ── HOSTED CLOUD MODE (Vercel + Supabase + AWS S3 + EC2 worker-cpu) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

STORAGE_PROVIDER=s3
AWS_REGION=ap-south-2
AWS_S3_BUCKET=vichith-media-prod
AWS_ACCESS_KEY_ID=your-aws-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# EC2 CPU Worker Wake-on-Demand (c7i.2xlarge in ap-south-2 Hyderabad)
CPU_WORKER_INSTANCE_ID=i-0b493811ffcdff29b
CPU_WORKER_AWS_REGION=ap-south-2
WORKER_CALLBACK_SECRET=your-worker-secret-token

# Vichith Compose Handoff Endpoint
NEXT_PUBLIC_VICHITH_URL=https://www.vichith.in

# ── SELF-HOSTED LOCAL MODE ────────────────────────────────────────────────────
# In local mode, zero cloud credentials are required.
# LOCAL_WORKER_URL=http://localhost:8000
# LOCAL_STORAGE_DIR=./storage
